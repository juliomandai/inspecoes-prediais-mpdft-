# Copie este arquivo como .env dentro da pasta src/ e preencha os valores.
# Gere uma SECRET_KEY com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=COLE-AQUI-A-CHAVE-GERADA-PELO-COMANDO-ACIMA

# Deixe False em producao
DEBUG=False

# Adicione o IP do servidor e o nome do host (ex: 192.168.1.50,mpdft-inspecoes)
ALLOWED_HOSTS=localhost,127.0.0.1,SEU-IP-AQUI

# Caminho para salvar fotos das inspecoes
MEDIA_ROOT=media
