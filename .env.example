# Copie este arquivo para .env e ajuste os valores antes de iniciar o servidor.

# Chave secreta do Django — gere com: python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=substitua-por-chave-secreta-longa-e-aleatoria

# Modo debug (True em desenvolvimento, False em produção)
DEBUG=True

# URL do banco de dados
# SQLite (padrão, sem servidor):
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (produção):
# DATABASE_URL=postgres://usuario:senha@localhost:5432/mpdft_inspecoes

# Pasta raiz para armazenamento de fotos enviadas
# Pode apontar para pasta sincronizada com OneDrive:
MEDIA_ROOT=media

# Hosts permitidos (separados por vírgula)
# Adicionar o IP/hostname do servidor em produção:
ALLOWED_HOSTS=localhost,127.0.0.1
